new file mode 100644
index 0000000..9f66459
--- /dev/null
+++ b/ios/Backburner/Sidecar/sme_a15_stub.c
@@ -0,0 +1,23 @@
+/* A15 experiment: SME2 benchmarking is unsupported; GPU tail inference stays enabled. */
+#include <stdio.h>
+#include <stdint.h>
+#include <stdlib.h>
+
+int sme2_available(void) { return 0; }
+
+int sme_bench(int argc, char **argv) {
+    (void)argc;
+    (void)argv;
+    fprintf(stderr, "SME2 is disabled in this A15 experiment\n");
+    return 1;
+}
+
+void sme_attn_pipe(void **pp, int nw, int nh, const float *Q, const uint8_t *K, const uint8_t *V,
+                   size_t rs, size_t hb, int is_q8, int nkv, int nk, float scale,
+                   float *O, float *m, float *l) {
+    (void)pp; (void)nw; (void)nh; (void)Q; (void)K; (void)V; (void)rs; (void)hb;
+    (void)is_q8; (void)nkv; (void)nk; (void)scale; (void)O; (void)m; (void)l;
+    /* An unavailable accelerator must never return fabricated attention values. */
+    fprintf(stderr, "unexpected SME2 attention request in A15 experiment\n");
+    abort();
+}
