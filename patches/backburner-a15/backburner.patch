diff --git a/scripts/text-only-gguf-a15.py b/scripts/text-only-gguf-a15.py
new file mode 100644
index 0000000..a84f11d
--- /dev/null
+++ b/scripts/text-only-gguf-a15.py
@@ -0,0 +1,37 @@
+"""Experimental decoder-only copy of a unified GGUF; source tensors are untouched."""
+import argparse
+from pathlib import Path
+import sys
+
+sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "llama.cpp" / "gguf-py"))
+import gguf
+
+parser = argparse.ArgumentParser()
+parser.add_argument("source", type=Path)
+parser.add_argument("output", type=Path)
+args = parser.parse_args()
+if args.output.exists():
+    raise ValueError("output already exists")
+r = gguf.GGUFReader(str(args.source))
+arch = r.get_field("general.architecture").contents()
+w = gguf.GGUFWriter(str(args.output), arch)
+for field in r.fields.values():
+    if field.name == "general.architecture" or field.name.startswith("GGUF."):
+        continue
+    if field.name.startswith(arch + ".vision."):
+        continue
+    value = field.contents()
+    w.add_key_value(field.name, value, field.types[0],
+                    sub_type=field.types[-1] if field.types[0] == gguf.GGUFValueType.ARRAY else None)
+tensors = [t for t in r.tensors if not t.name.startswith(("v.", "mtp."))]
+for tensor in tensors:
+    w.add_tensor_info(tensor.name, tensor.data.shape, tensor.data.dtype,
+                      tensor.data.nbytes, tensor.tensor_type)
+w.write_header_to_file()
+w.write_kv_data_to_file()
+w.write_ti_data_to_file()
+for tensor in tensors:
+    w.write_tensor_data(tensor.data, tensor_endianess=r.endianess)
+w.close()
+print({"decoder_tensors": len(tensors), "bytes": args.output.stat().st_size,
+       "source_changed": False, "output": str(args.output)})
